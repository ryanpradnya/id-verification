# Copy to .env and fill in. Never commit .env.

# Required. Encrypts stored images, KTP data and webhook secrets. Losing it = data unreadable.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# Public URL of this service (used to build hosted capture links). Must be https in production:
# browsers only allow camera access on https or localhost.
PUBLIC_BASE_URL=http://localhost:8000

# --- AI provider: any LangChain init_chat_model id. The model must accept images. ---
# Anthropic
LLM_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OpenAI:      LLM_MODEL=openai:gpt-5         + OPENAI_API_KEY=
# OpenRouter:  LLM_MODEL=openrouter:google/gemini-2.5-pro + OPENROUTER_API_KEY=
# Any OpenAI-compatible endpoint (DeepSeek, vLLM, Ollama, ...):
#   LLM_MODEL=openai:<model>  LLM_BASE_URL=https://.../v1  LLM_API_KEY=...
# Optional second provider used when the first fails (reads its own *_API_KEY env var):
# LLM_FALLBACK_MODEL=openai:gpt-5
LLM_TIMEOUT_SECONDS=60

# --- Storage (defaults match docker-compose's local SeaweedFS) ---
S3_BUCKET=kyc
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
S3_REGION=us-east-1
# S3_ENDPOINT_URL=  (unset for AWS S3)

# --- Tuning (defaults shown) ---
# FACE_MATCH_THRESHOLD=0.363
# LIVENESS_THRESHOLD=0.80
# MIN_IMAGE_SIDE=300
# MIN_BLUR_VARIANCE=30
# MIN_BRIGHTNESS=40
# RETENTION_DAYS=30
# RATE_LIMIT_PER_MINUTE=60
# CAPTURE_SESSION_MINUTES=15
# WEBHOOK_ALLOW_HTTP=false   # dev only: allows http:// and private-network webhook targets
