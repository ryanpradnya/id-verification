# Copy to .env and fill in. Never commit .env.

# Required by the server. Encrypts stored images, KTP data and webhook secrets. Losing it = data unreadable.
#   id-verification gen-key
DATA_ENCRYPTION_KEY=

# Public URL of this service (used to build hosted capture links). Must be https in production:
# browsers only allow camera access on https or localhost. Include the prefix if you mount the app (…/kyc).
PUBLIC_BASE_URL=http://localhost:8000

# --- AI model. The model must accept images. Check it with: id-verification check-llm ---
# No LLM at all: local OCR + local face models. Tamper/recapture checks are skipped (see skipped_checks).
LLM_MODEL=none
# Local / self-hosted, any OpenAI-compatible server:
#   Ollama:     LLM_MODEL=openai:qwen2.5vl:7b   LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama
#   vLLM:       LLM_MODEL=openai:Qwen/Qwen2.5-VL-7B-Instruct   LLM_BASE_URL=http://localhost:8001/v1
#   LM Studio:  LLM_MODEL=openai:<loaded model id>   LLM_BASE_URL=http://localhost:1234/v1
# Cloud:
#   LLM_MODEL=anthropic:claude-sonnet-5-5   ANTHROPIC_API_KEY=...      (pip install 'id-verification[anthropic]')
#   LLM_MODEL=openai:gpt-5                  OPENAI_API_KEY=...
#   LLM_MODEL=openrouter:google/gemini-2.5-pro  OPENROUTER_API_KEY=... (pip install 'id-verification[openrouter]')
# Optional second provider used when the first fails (reads its own *_API_KEY env var):
# LLM_FALLBACK_MODEL=openai:gpt-5
# Small local models that fail at tool calling: LLM_STRUCTURED_METHOD=json_mode
# LLM_TIMEOUT_SECONDS=60

# --- Lite mode (default): SQLite + encrypted files under DATA_DIR, in-process worker ---
# DATA_DIR=data

# --- Scale mode: set any of these to switch that piece ---
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/kyc
# REDIS_URL=redis://host:6379/0           # Celery queue + shared rate limit; run the celery worker too
# S3_BUCKET=kyc                           # S3 storage instead of local disk
# S3_ENDPOINT_URL=                        # unset for AWS S3; set for R2 / MinIO / SeaweedFS
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# --- Tuning (defaults shown) ---
# FACE_MATCH_THRESHOLD=0.363
# LIVENESS_THRESHOLD=0.80
# MIN_IMAGE_SIDE=300
# MIN_BLUR_VARIANCE=30
# MIN_BRIGHTNESS=40
# RETENTION_DAYS=30
# RATE_LIMIT_PER_MINUTE=60
# CAPTURE_SESSION_MINUTES=15
# WORKER_CONCURRENCY=2
# WEBHOOK_ALLOW_HTTP=false   # dev only: allows http:// and private-network webhook/redirect targets
